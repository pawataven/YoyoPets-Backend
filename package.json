{
  "name": "yoyopet-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "types:supabase": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > shared/types/database.types.ts",
    "types:supabase:local": "supabase gen types typescript --db-url $SUPABASE_DB_URL --schema public > shared/types/database.types.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.154",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/supabase": "^2.1.0",
    "eslint": "^10.15.0",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
