# Supabase project URL and publishable key. Never put the service role key here.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Used by `bun run types:supabase` / `bun run types:supabase:local`
SUPABASE_PROJECT_ID=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Member web app, opened by the "ดูหน้าเว็บสมาชิก" link in the top bar
NUXT_PUBLIC_MEMBER_SITE_URL=http://localhost:3000
